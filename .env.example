# stemLM analytics configuration (GA4 Measurement Protocol)
#
# Copy this file to `.env` and fill in both values to enable analytics.
# Leave either value empty for a safe no-op: no storage lookup or network call.
# `.env` is ignored and must never be committed.
#
# How to get these:
#   1. Create a GA4 property at https://analytics.google.com
#   2. Admin -> Data Streams -> Web -> Create stream  => Measurement ID (G-XXXXXXXXXX)
#   3. In that stream: Measurement Protocol API secrets -> Create  => API secret
#
# These are read at build time by wxt.config.ts.

# GA4 Measurement ID for the web data stream, usually formatted like G-XXXXXXXXXX.
STEMLM_GA_MEASUREMENT_ID=

# GA4 Measurement Protocol API secret for the same web data stream.
STEMLM_GA_API_SECRET=
